{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@scene": [
        "packages/core/src/code/placeholder.tsx"
      ],
      "@kit": [
        "packages/core/src/kit/index.ts"
      ]
    }
  },
  "include": [
    "packages/core/src",
    "packages/qa/src",
    "scripts",
    "apps/cli",
    "remotion.config.ts"
  ]
}